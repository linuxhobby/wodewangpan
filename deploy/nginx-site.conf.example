# 站点 Nginx 配置 —— 放到 /etc/nginx/conf.d/wodewangpan.conf
# 改 2 处即可：server_name（下面每段里的都要换）、ssl_certificate / ssl_certificate_key（certbot 会自动改）
# 没有启用访问统计的话，把 access_log 那行改回默认、并删掉 location = /stats.json 与 /hit 两段
# deploy/ 里还有三个 http 级文件要一并放进 /etc/nginx/conf.d/：00-sitestats.conf（日志格式）、
# 00-block-probes.conf（扫描器屏蔽规则）、00-block-ai.conf（零回流 AI 爬虫名单）。
# 缺后两个的话下面开头的 $probe_block / $ai_block 无定义，nginx -t 会直接报错。
#
# 规范化目标（SEO）：全站只有 https://www.<域名>/ 返回 200，
# http 与裸域一律「单跳」301 过去——跳一次是标准做法，蜘蛛不会被劝退；
# 真正要避免的是 http / https、裸域 / www 各留一份 200 副本，那才叫重复内容。

# ── 1）站点本体（证书签发前也只有这一段生效，certbot 靠它完成 HTTP-01 校验） ──
server {
    # 公网漏洞扫描器直接断连：规则见 00-block-probes.conf，命中即关连接、不回应、不发 body。
    # 必须放本块第一行——早于裸域与 http→https 的跳转，探测请求连 301 都拿不到。
    # certbot 生成 443 段后，这一行也要复制进每个 server 块（含下面注释掉的裸域段）。
    if ($probe_block) { return 444; }

    # 只抓不回流的 AI 索引爬虫（ShapBot / KeenableBot / SkytabBot）→ 403，
    # 名单见 00-block-ai.conf；Googlebot / Yandex / Perplexity / Claude / GPT 均不在名单内。
    if ($ai_block) { return 403; }

    listen 80;
    server_name your-domain.com www.your-domain.com;          # ← 换成你的域名（裸域与 www 都写）

    root /opt/wodewangpan/public;       # ← 指向 public 目录本身
    index index.html;

    charset utf-8;

    # 访问统计专用日志格式（在 00-sitestats.conf 里定义）；不统计就删掉这一行，用默认 access_log
    access_log /var/log/nginx/access.log sitestats;

    gzip on;
    gzip_vary on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    # text/xml 必须写：nginx 的 mime.types 把 .xml 映射成 text/xml，不是 application/xml。
    # 只写 application/xml 的话 sitemap.xml / feed.xml 完全不压缩（实测响应头只有 content-length
    # 210066 / 78433，没有 content-encoding）。application/rss+xml、application/atom+xml 同理，
    # 供自建 feed 端点显式声明 Content-Type 时使用。
    gzip_types text/plain text/css application/javascript application/json text/xml application/xml application/rss+xml application/atom+xml image/svg+xml;

    # 蜘蛛记忆里的残留 URL：app.js 早期用相对路径取 search-index.json，
    # 在 /<slug>/<id>/、/<slug>/ 下解析成 /<slug>/<id>/search-index.json 这类不存在的路径。
    # 现已改为根绝对路径，但蜘蛛仍会重试旧地址，且每发现一个新资源页就多一条（日志里逐日递增）。
    # 410 Gone 比 404 衰退更快；只匹配「带目录前缀」的，根目录那份要留给 Googlebot 渲染「加载更多」。
    # 必须放在下面静态资源 location 之前：nginx 的正则 location 按出现顺序取第一个命中。
    # ── 旧 URL → 新 URL（2026-11-15 全站改为 /<分类 slug>/ 与 /<分类 slug>/<id>/）──────────
    # 顺序要求：具体 id 的历史 301 必须在按前缀的泛化规则之前，否则 ot-007 会被泛化成 /misc/ot-007/。
    # 中文分类路径（2026-10-08 启用 slugs 时的旧收录地址）
    rewrite ^/category/电影/(.*)$      /movie/$1 permanent;
    rewrite ^/category/电影/?$         /movie/ permanent;
    rewrite ^/category/电视剧/(.*)$    /tv/$1 permanent;
    rewrite ^/category/电视剧/?$       /tv/ permanent;
    rewrite ^/category/纪录片/(.*)$    /documentary/$1 permanent;
    rewrite ^/category/纪录片/?$       /documentary/ permanent;
    rewrite ^/category/动漫/(.*)$      /anime/$1 permanent;
    rewrite ^/category/动漫/?$         /anime/ permanent;
    rewrite ^/category/游戏/(.*)$      /game/$1 permanent;
    rewrite ^/category/游戏/?$         /game/ permanent;
    rewrite ^/category/软件/(.*)$      /software/$1 permanent;
    rewrite ^/category/软件/?$         /software/ permanent;
    rewrite ^/category/电子书/(.*)$    /ebook/$1 permanent;
    rewrite ^/category/电子书/?$       /ebook/ permanent;
    rewrite ^/category/其他/(.*)$      /misc/$1 permanent;
    rewrite ^/category/其他/?$         /misc/ permanent;

    # 分类合并：2026-11-10「操作系统」并入「软件」，旧分类页与分类 RSS 一律 301
    rewrite ^/category/os/(feed\.xml)?$ /software/$1 permanent;
    # 旧英文分类页 /category/<slug>/ → /<slug>/（feed.xml、index.html 一并带走）
    rewrite ^/category/(movie|tv|documentary|anime|game|software|ebook|course|misc)/index\.html$ /$1/ permanent;
    rewrite ^/category/(movie|tv|documentary|anime|game|software|ebook|course|misc)/(feed\.xml)?$ /$1/$2 permanent;

    # 资源换分类残留 URL：2026-11-10 ot-007 → app-141，目标地址换成新路径。
    # 2026-11-13 撤销 ot-006 → cs-018：ot-006 已重新入库，id 空洞复用前必须先删该 id 的历史 301。
    rewrite ^/resource/ot-007(/index\.html|/)?$ /software/app-141/ permanent;
    # 2026-11-10 前缀统一：原「操作系统」11 条 os-001~011 → app-130~140
    rewrite ^/resource/os-001(/index\.html|/)?$ /software/app-134/ permanent;
    rewrite ^/resource/os-002(/index\.html|/)?$ /software/app-135/ permanent;
    rewrite ^/resource/os-003(/index\.html|/)?$ /software/app-130/ permanent;
    rewrite ^/resource/os-004(/index\.html|/)?$ /software/app-131/ permanent;
    rewrite ^/resource/os-005(/index\.html|/)?$ /software/app-132/ permanent;
    rewrite ^/resource/os-006(/index\.html|/)?$ /software/app-133/ permanent;
    rewrite ^/resource/os-007(/index\.html|/)?$ /software/app-138/ permanent;
    rewrite ^/resource/os-008(/index\.html|/)?$ /software/app-139/ permanent;
    rewrite ^/resource/os-009(/index\.html|/)?$ /software/app-140/ permanent;
    rewrite ^/resource/os-010(/index\.html|/)?$ /software/app-136/ permanent;
    rewrite ^/resource/os-011(/index\.html|/)?$ /software/app-137/ permanent;

    # 2026-11-22 撞号重编号：旧 id → 新 id（历史 /resource/ 与现行 /<slug>/ 两种地址都覆盖）。
    rewrite ^/resource/cs-035(/index\.html|/)?$ /course/cs-043/ permanent;
    rewrite ^/resource/cs-038(/index\.html|/)?$ /course/cs-044/ permanent;
    rewrite ^/resource/cs-039(/index\.html|/)?$ /course/cs-045/ permanent;
    rewrite ^/resource/cs-040(/index\.html|/)?$ /course/cs-046/ permanent;
    rewrite ^/resource/cs-041(/index\.html|/)?$ /course/cs-047/ permanent;
    rewrite ^/resource/bk-023(/index\.html|/)?$ /ebook/bk-026/ permanent;
    rewrite ^/resource/bk-024(/index\.html|/)?$ /ebook/bk-027/ permanent;
    rewrite ^/resource/bk-025(/index\.html|/)?$ /ebook/bk-028/ permanent;
    rewrite ^/resource/game-050(/index\.html|/)?$ /game/game-061/ permanent;
    rewrite ^/resource/game-056(/index\.html|/)?$ /game/game-062/ permanent;
    rewrite ^/resource/game-057(/index\.html|/)?$ /game/game-063/ permanent;
    rewrite ^/resource/game-058(/index\.html|/)?$ /game/game-064/ permanent;
    rewrite ^/resource/game-059(/index\.html|/)?$ /game/game-065/ permanent;
    rewrite ^/course/cs-035(/index\.html|/)?$ /course/cs-043/ permanent;
    rewrite ^/course/cs-038(/index\.html|/)?$ /course/cs-044/ permanent;
    rewrite ^/course/cs-039(/index\.html|/)?$ /course/cs-045/ permanent;
    rewrite ^/course/cs-040(/index\.html|/)?$ /course/cs-046/ permanent;
    rewrite ^/course/cs-041(/index\.html|/)?$ /course/cs-047/ permanent;
    rewrite ^/ebook/bk-023(/index\.html|/)?$ /ebook/bk-026/ permanent;
    rewrite ^/ebook/bk-024(/index\.html|/)?$ /ebook/bk-027/ permanent;
    rewrite ^/ebook/bk-025(/index\.html|/)?$ /ebook/bk-028/ permanent;
    rewrite ^/game/game-050(/index\.html|/)?$ /game/game-061/ permanent;
    rewrite ^/game/game-056(/index\.html|/)?$ /game/game-062/ permanent;
    rewrite ^/game/game-057(/index\.html|/)?$ /game/game-063/ permanent;
    rewrite ^/game/game-058(/index\.html|/)?$ /game/game-064/ permanent;
    rewrite ^/game/game-059(/index\.html|/)?$ /game/game-065/ permanent;

    # 旧详情页 /resource/<id>/ → /<slug>/<id>/：9 个 id 前缀与分类一一对应（1040 条实测）。
    # 新地址由 build.js 的 setItemPaths() 以数据里的 category 为准生成，不依赖前缀约定。
    rewrite ^/resource/(mv-[^/]+)(/index\.html|/)?$ /movie/$1/ permanent;
    rewrite ^/resource/(tv-[^/]+)(/index\.html|/)?$ /tv/$1/ permanent;
    rewrite ^/resource/(dc-[^/]+)(/index\.html|/)?$ /documentary/$1/ permanent;
    rewrite ^/resource/(an-[^/]+)(/index\.html|/)?$ /anime/$1/ permanent;
    rewrite ^/resource/(game-[^/]+)(/index\.html|/)?$ /game/$1/ permanent;
    rewrite ^/resource/(app-[^/]+)(/index\.html|/)?$ /software/$1/ permanent;
    rewrite ^/resource/(bk-[^/]+)(/index\.html|/)?$ /ebook/$1/ permanent;
    rewrite ^/resource/(cs-[^/]+)(/index\.html|/)?$ /course/$1/ permanent;
    rewrite ^/resource/(ot-[^/]+)(/index\.html|/)?$ /misc/$1/ permanent;

    # 标签词表治理（2026-11-16）：同义标签合并 / 作品名标签删除后，旧聚合页 301 到合并后的地址。
    # 标签页不在 sitemap 内，但站内历史链接与已抓取快照仍会命中，别让它们落到 404。
    # jilu 原为「纪录」（已并入分类「纪录片」）、yijifangchengshi… 与 taersazhiwang… 是作品名标签，归各自分类页。
    rewrite ^/tag/x64(/index\.html|/)?$ /tag/x86-64/ permanent;
    rewrite ^/tag/war-politics(/index\.html|/)?$ /tag/zhengzhi/ permanent;
    rewrite ^/tag/foreign-literature(/index\.html|/)?$ /tag/literature/ permanent;
    rewrite ^/tag/jilu(/index\.html|/)?$ /documentary/ permanent;
    rewrite ^/tag/openai-codex(/index\.html|/)?$ /tag/aibiancheng/ permanent;
    rewrite ^/tag/yasi(/index\.html|/)?$ /tag/yingyukaoshi/ permanent;
    rewrite ^/tag/yijifangchengshi-jisuzhengsheng-formula-1-drive-to-survive(/index\.html|/)?$ /documentary/ permanent;
    rewrite ^/tag/taersazhiwang-tulsa-king(/index\.html|/)?$ /tv/ permanent;

    # 静态资源长期缓存；HTML 不缓存，更新即时生效
    location ~* \.(css|js|json|svg|webp|png|jpg|jpeg|gif|ico)$ {
        expires 30d;
        add_header Cache-Control "public, max-age=2592000";
        access_log off;
    }

    # index.html → 目录式 URL：同一页面避免留下两个可抓取地址（SEO 重复内容）
    # 用 $request_uri 判断；nginx index 指令触发的是内部重定向、不会改写它，因此不会循环
    if ($request_uri ~* "^(.*/)index\.html(\?.*)?$") {
        return 301 $1;
    }

    # 目录式 URL：让 /movie/mv-010/ 命中 movie/mv-010/index.html
    location / {
        try_files $uri $uri/ $uri/index.html =404;
    }

    # 访问统计（删掉则不启用）
    location = /stats.json {
        alias /var/lib/sitestats/stats.json;
        default_type application/json;
        add_header Cache-Control "no-store";
        add_header Access-Control-Allow-Origin "*";
    }
    location = /hit { return 204; }

    # IndexNow 密钥（钥匙串方式向 Bing 等实时递交 URL，可删）
    location = /key.txt { alias /opt/indexnow/key.txt; default_type text/plain; }

    # 搜索引擎的站点验证文件（百度 / 必应等），同样放构建目录外、由 nginx 直接托管。
    # 别放进 static/ 或 public/：站点是构建到 public.new 再整目录换过去的，
    # 任何不在构建产物里的文件都会在下一次发布时被 rm -rf public.old 清掉。
    # location = /baidu_verify_xxxxxxxx.html { alias /opt/seo/baidu_verify_xxxxxxxx.html; default_type text/html; }

    error_page 404 /404.html;

    location /.well-known/acme-challenge/ { root /var/www/html; }
}

# ── 2）证书签发后（README 步骤 6 之后）再做两件事 ──
#
# a) 让 http 只做跳转。certbot 加 --redirect 会自动改写上面的 80 段：
#      sudo certbot --nginx --redirect -d 你的域名 -d www.你的域名
#    它保留 acme 校验路径、把 location / 换成 301，不需要手工改。
#    手工做的话把上面「目录式 URL」那段换成：
#      location / { return 301 https://www.your-domain.com$request_uri; }
#
# b) 裸域 https → www。证书这时已存在，去掉下面整段的注释并 reload：
# server {
#     if ($probe_block) { return 444; }          # 与 80 段一样，扫描器在跳转前就被掐掉
#     listen 443 ssl;
#     server_name your-domain.com;
#     ssl_certificate     /etc/letsencrypt/live/your-domain.com/fullchain.pem;
#     ssl_certificate_key /etc/letsencrypt/live/your-domain.com/privkey.pem;
#     return 301 https://www.your-domain.com$request_uri;
# }
#
# 改完自检（三个都应 200→301 直达 https://www.<域名>/，且只有最后一跳是 200）：
#   curl -s -o /dev/null -w '%{http_code} %{redirect_url}\n' http://你的域名/
#   curl -s -o /dev/null -w '%{http_code} %{redirect_url}\n' http://www.你的域名/
#   curl -s -o /dev/null -w '%{http_code} %{redirect_url}\n' https://你的域名/
