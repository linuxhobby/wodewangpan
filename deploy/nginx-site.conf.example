# 站点 Nginx 配置 —— 放到 /etc/nginx/conf.d/wodewangpan.conf
# 改 2 处即可：server_name（下面每段里的都要换）、ssl_certificate / ssl_certificate_key（certbot 会自动改）
# 没有启用访问统计的话，把 access_log 那行改回默认、并删掉 location = /stats.json 与 /hit 两段
# deploy/ 里还有三个 http 级文件要一并放进 /etc/nginx/conf.d/：00-sitestats.conf（日志格式）、
# 00-block-probes.conf（扫描器屏蔽规则）、00-block-ai.conf（零回流 AI 爬虫名单）。
# 缺后两个的话下面开头的 $probe_block / $ai_block 无定义，nginx -t 会直接报错。
#
# 规范化目标（SEO）：全站只有 https://www.<域名>/ 返回 200，
# http 与裸域一律「单跳」301 过去——跳一次是标准做法，蜘蛛不会被劝退；
# 真正要避免的是 http / https、裸域 / www 各留一份 200 副本，那才叫重复内容。

# ── 1）站点本体（证书签发前也只有这一段生效，certbot 靠它完成 HTTP-01 校验） ──
server {
    # 公网漏洞扫描器直接断连：规则见 00-block-probes.conf，命中即关连接、不回应、不发 body。
    # 必须放本块第一行——早于裸域与 http→https 的跳转，探测请求连 301 都拿不到。
    # certbot 生成 443 段后，这一行也要复制进每个 server 块（含下面注释掉的裸域段）。
    if ($probe_block) { return 444; }

    # 只抓不回流的 AI 索引爬虫（ShapBot / KeenableBot / SkytabBot）→ 403，
    # 名单见 00-block-ai.conf；Googlebot / Yandex / Perplexity / Claude / GPT 均不在名单内。
    if ($ai_block) { return 403; }

    listen 80;
    server_name your-domain.com www.your-domain.com;          # ← 换成你的域名（裸域与 www 都写）

    root /opt/wodewangpan/public;       # ← 指向 public 目录本身
    index index.html;

    charset utf-8;

    # 访问统计专用日志格式（在 00-sitestats.conf 里定义）；不统计就删掉这一行，用默认 access_log
    access_log /var/log/nginx/access.log sitestats;

    gzip on;
    gzip_vary on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml application/xml;

    # 蜘蛛记忆里的残留 URL：app.js 早期用相对路径取 search-index.json，
    # 在 /resource/<id>/、/category/<slug>/ 下解析成 /resource/<id>/search-index.json 这类不存在的路径。
    # 现已改为根绝对路径，但蜘蛛仍会重试旧地址，且每发现一个新资源页就多一条（日志里逐日递增）。
    # 410 Gone 比 404 衰退更快；只匹配「带目录前缀」的，根目录那份要留给 Googlebot 渲染「加载更多」。
    # 必须放在下面静态资源 location 之前：nginx 的正则 location 按出现顺序取第一个命中。
    location ~ ^/.+/search-index\.json$ { return 410; }

    # 静态资源长期缓存；HTML 不缓存，更新即时生效
    location ~* \.(css|js|json|svg|webp|png|jpg|jpeg|gif|ico)$ {
        expires 30d;
        add_header Cache-Control "public, max-age=2592000";
        access_log off;
    }

    # index.html → 目录式 URL：同一页面避免留下两个可抓取地址（SEO 重复内容）
    # 用 $request_uri 判断；nginx index 指令触发的是内部重定向、不会改写它，因此不会循环
    if ($request_uri ~* "^(.*/)index\.html(\?.*)?$") {
        return 301 $1;
    }

    # 目录式 URL：让 /resource/mv-010/ 命中 resource/mv-010/index.html
    location / {
        try_files $uri $uri/ $uri/index.html =404;
    }

    # 访问统计（删掉则不启用）
    location = /stats.json {
        alias /var/lib/sitestats/stats.json;
        default_type application/json;
        add_header Cache-Control "no-store";
        add_header Access-Control-Allow-Origin "*";
    }
    location = /hit { return 204; }

    # IndexNow 密钥（钥匙串方式向 Bing 等实时递交 URL，可删）
    location = /key.txt { alias /opt/indexnow/key.txt; default_type text/plain; }

    # 搜索引擎的站点验证文件（百度 / 必应等），同样放构建目录外、由 nginx 直接托管。
    # 别放进 static/ 或 public/：站点是构建到 public.new 再整目录换过去的，
    # 任何不在构建产物里的文件都会在下一次发布时被 rm -rf public.old 清掉。
    # location = /baidu_verify_xxxxxxxx.html { alias /opt/seo/baidu_verify_xxxxxxxx.html; default_type text/html; }

    error_page 404 /404.html;

    location /.well-known/acme-challenge/ { root /var/www/html; }
}

# ── 2）证书签发后（README 步骤 6 之后）再做两件事 ──
#
# a) 让 http 只做跳转。certbot 加 --redirect 会自动改写上面的 80 段：
#      sudo certbot --nginx --redirect -d 你的域名 -d www.你的域名
#    它保留 acme 校验路径、把 location / 换成 301，不需要手工改。
#    手工做的话把上面「目录式 URL」那段换成：
#      location / { return 301 https://www.your-domain.com$request_uri; }
#
# b) 裸域 https → www。证书这时已存在，去掉下面整段的注释并 reload：
# server {
#     if ($probe_block) { return 444; }          # 与 80 段一样，扫描器在跳转前就被掐掉
#     listen 443 ssl;
#     server_name your-domain.com;
#     ssl_certificate     /etc/letsencrypt/live/your-domain.com/fullchain.pem;
#     ssl_certificate_key /etc/letsencrypt/live/your-domain.com/privkey.pem;
#     return 301 https://www.your-domain.com$request_uri;
# }
#
# 改完自检（三个都应 200→301 直达 https://www.<域名>/，且只有最后一跳是 200）：
#   curl -s -o /dev/null -w '%{http_code} %{redirect_url}\n' http://你的域名/
#   curl -s -o /dev/null -w '%{http_code} %{redirect_url}\n' http://www.你的域名/
#   curl -s -o /dev/null -w '%{http_code} %{redirect_url}\n' https://你的域名/
