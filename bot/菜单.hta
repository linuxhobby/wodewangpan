<!DOCTYPE html>
<html>
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<title>机器人控制台</title>
<HTA:APPLICATION
  ID="app"
  APPLICATIONNAME="机器人控制台"
  BORDER="thin"
  CAPTION="yes"
  CONTEXTMENU="no"
  INNERBORDER="no"
  MAXIMIZEBUTTON="no"
  MINIMIZEBUTTON="no"
  NAVIGABLE="no"
  SCROLL="no"
  SELECTION="no"
  SHOWINTASKBAR="yes"
  SINGLEINSTANCE="yes"
  SYSMENU="yes"
  WINDOWSTATE="normal">
<style>
  body { margin:0; padding:18px 22px 20px; background:#f4f6fa; color:#1f2937;
         font-family:"Microsoft YaHei UI","Microsoft YaHei",sans-serif; }
  h1 { margin:0; font-size:23px; font-weight:600; }
  .sub { margin:6px 0 14px; font-size:13px; color:#6b7280; }
  .group { margin:14px 0 9px; font-size:14px; font-weight:600; color:#2563eb; }
  .item { display:block; width:100%; margin:0 0 9px; padding:11px 14px;
          font-family:inherit; font-size:17px; text-align:left; color:#1f2937;
          background:#fff; border:1px solid #d5dce5; border-radius:8px; cursor:pointer; }
  .item:hover { background:#eaf2ff; border-color:#2563eb; color:#1d4ed8; }
  .num { display:inline-block; width:34px; font-weight:700; color:#2563eb; }
  .foot { margin-top:16px; padding-top:14px; border-top:1px solid #d5dce5; font-size:14px; color:#4b5563; }
  #pick { width:72px; padding:6px 9px; font-family:inherit; font-size:17px;
          border:1px solid #d5dce5; border-radius:6px; }
  #go { margin-left:8px; padding:7px 18px; font-family:inherit; font-size:15px; color:#fff;
        background:#2563eb; border:0; border-radius:6px; cursor:pointer; }
  #msg { height:20px; margin-top:8px; font-size:14px; color:#dc2626; }

  /* ---- 扫码面板 ---- */
  #qr-panel { display:none; text-align:center; }
  #qr-imgbox { width:340px; height:340px; margin:6px auto 10px; padding:12px;
               background:#fff; border:1px solid #d5dce5; border-radius:10px; }
  #qr-imgbox img { width:316px; height:316px; display:none; }
  #qr-status { min-height:24px; font-size:16px; font-weight:600; color:#1f2937; }
  #qr-status.ok { color:#16a34a; }
  #qr-status.warn { color:#d97706; }
  #qr-tip { font-size:13px; color:#6b7280; margin-top:6px; }
  .back { margin-top:12px; padding:8px 26px; font-family:inherit; font-size:15px;
          color:#374151; background:#fff; border:1px solid #d5dce5; border-radius:6px; cursor:pointer; }
</style>
</head>
<body onload="init()">
  <div id="menu">
    <h1>机器人控制台</h1>
    <div class="sub">点击按钮，或输入序号 1-7 后回车 · Esc 退出</div>

    <div class="group">QQ 机器人</div>
    <button class="item" onclick="run(0)"><span class="num">1</span>启动QQ机器人</button>
    <button class="item" onclick="run(1)"><span class="num">2</span>重启QQ机器人</button>
    <button class="item" onclick="run(2)"><span class="num">3</span>结束QQ机器人</button>
    <button class="item" onclick="run(3)"><span class="num">4</span>QQ扫码登录</button>

    <div class="group">TG 机器人</div>
    <button class="item" onclick="run(4)"><span class="num">5</span>启动TG机器人</button>
    <button class="item" onclick="run(5)"><span class="num">6</span>重启TG机器人</button>
    <button class="item" onclick="run(6)"><span class="num">7</span>结束TG机器人</button>

    <div class="foot">
      输入序号：<input id="pick" type="text" maxlength="2" autocomplete="off">
      <button id="go" onclick="goPick()">执行</button>
      <div id="msg"></div>
    </div>
  </div>

  <div id="qr-panel">
    <h1>QQ 扫码登录</h1>
    <div class="sub">二维码会自动出现在下方并随 NapCat 刷新，手机 QQ 扫一扫即可</div>
    <div id="qr-imgbox"><img id="qrimg" alt="二维码"></div>
    <div id="qr-status">正在检测 NapCat 状态…</div>
    <div id="qr-tip">二维码几分钟自动过期；迟迟没有新码时会自动重启 NapCat 换新码。</div>
    <button class="back" onclick="closeQr()">返回菜单</button>
  </div>

<script language="JavaScript">
var NAPBAT = 'C:\\Users\\marco\\Downloads\\NapCatOneKey\\NapCat.Shell.v4\\napcat.bat';
var QR_IMG = 'C:\\Users\\marco\\Downloads\\NapCatOneKey\\NapCat.Shell.v4\\napcat\\cache\\qrcode.png';
var PY = 'C:\\Users\\marco\\.workbuddy\\tools\\venv\\Scripts\\python.exe';
var QR_TOOL = 'C:\\Users\\marco\\Github\\wodewangpan\\bot\\scripts\\qr_desktop.py';
var QR_OUT_DIR = 'C:\\Users\\marco\\AppData\\Local\\Temp\\qq-qr';   // 仓库外，临时码不入 git
var QQUIN = '909008620';
var qrTimer = null, qrBaseMs = 0, qrStart = 0, qrShown = false, qrRestarts = 0;

function botDir(sh) {
  var d = sh.ExpandEnvironmentStrings('%WODEWANGPAN_BOT_DIR%');
  if (d && d.charAt(0) !== '%' && d.indexOf('\\') >= 0) return d.replace(/\\+$/, '');
  var p = decodeURIComponent(location.pathname.replace(/^\//, '').replace(/\//g, '\\'));
  return p.substring(0, p.lastIndexOf('\\'));
}

function run(i) {
  if (i === 3) { showQr(); return; }   // 扫码在 HTA 内直接呈现
  var sh = new ActiveXObject('WScript.Shell');
  sh.Run('wscript.exe "' + botDir(sh) + '\\菜单.vbs" ' + (i + 1), 1, false);
  window.close();
}

function goPick() {
  var v = document.getElementById('pick').value.replace(/^\s+|\s+$/g, '');
  if (/^[1-7]$/.test(v)) run(parseInt(v, 10) - 1);
  else document.getElementById('msg').innerText = '请输入 1-7 的序号';
}

function init() {
  try {
    window.resizeTo(560, 680);
    window.moveTo(Math.max(0, (screen.width - 560) / 2), Math.max(0, (screen.height - 680) / 2));
  } catch (e) {}
  document.getElementById('pick').focus();
  document.onkeydown = onKey;
}

function onKey() {
  var e = window.event, k = e.keyCode;
  if (k === 27) { window.close(); return; }
  if (document.getElementById('qr-panel').style.display === 'block') return;
  if (k === 13) { goPick(); return; }
  if (e.srcElement && e.srcElement.id === 'pick') return;
  if (k >= 49 && k <= 55) run(k - 49);
  else if (k >= 97 && k <= 103) run(k - 97);
}

/* ---------------- 扫码面板 ---------------- */

function stat(text, cls) {
  var el = document.getElementById('qr-status');
  el.innerText = text;
  el.className = cls || '';
}

// 统一解析成毫秒时间戳；FSO 的 DateLastModified 在 JScript 里类型不稳定，
// 直接 .getTime() 会抛异常（14:02 那次「画了码面板却没反应」的根因）
function mtimeMs(p) {
  try {
    var v = new ActiveXObject('Scripting.FileSystemObject').GetFile(p).DateLastModified;
    var d = new Date(v);
    return d.getTime();
  } catch (e) { return 0; }
}

// 用 WMI 按命令行判 NapCat 是否在跑；HTTP 探 WebUI 会被 301 重定向坑（双实例事故的根因）
function napcatRunning() {
  try {
    var wmi = GetObject('winmgmts:\\\\.\\root\\cimv2');
    var items = wmi.ExecQuery("SELECT CommandLine FROM Win32_Process WHERE Name='node.exe'");
    var e = new Enumerator(items);
    for (; !e.atEnd(); e.moveNext()) {
      var cl = String(e.item().CommandLine || '');
      if (cl.indexOf('NapCat.Shell.v4') >= 0) return true;
    }
    return false;
  } catch (err) { return null; }   // WMI 不可用时返回未知
}

function httpGet(url) {
  try {
    var x = new ActiveXObject('MSXML2.XMLHTTP');
    x.open('GET', url, false);
    x.setRequestHeader('If-Modified-Since', 'Thu, 01 Jan 1970 00:00:00 GMT');
    x.send(null);
    return x.status;
  } catch (e) { return 0; }
}

function showQr() {
  document.getElementById('menu').style.display = 'none';
  document.getElementById('qr-panel').style.display = 'block';
  document.getElementById('qrimg').style.display = 'none';
  try {
    window.resizeTo(560, 800);
    window.moveTo(Math.max(0, (screen.width - 560) / 2), Math.max(0, (screen.height - 800) / 2));
  } catch (e) {}
  qrStart = (new Date()).getTime();
  qrBaseMs = mtimeMs(QR_IMG);
  qrShown = false;
  qrRestarts = 0;

  // NapCat 没在跑才补启；跑着就不动它，等它画码
  var running = napcatRunning();
  if (running === false || (running === null && httpGet('http://127.0.0.1:6099/') === 0)) {
    stat('NapCat 没在跑，正在启动…');
    restartNapcat(false);
  } else {
    stat('NapCat 在跑，等待/读取二维码…');
  }

  // 现有码是 90 秒内画的就算新鲜，直接展示，不等下一张
  if (qrBaseMs > 0) {
    var age = ((new Date()).getTime() - qrBaseMs) / 1000;
    if (age >= 0 && age < 90) genQr();
  }

  qrTimer = window.setInterval(qrTick, 2000);
}

function closeQr() {
  if (qrTimer) { window.clearInterval(qrTimer); qrTimer = null; }
  document.getElementById('qr-panel').style.display = 'none';
  document.getElementById('menu').style.display = 'block';
  try {
    window.resizeTo(560, 680);
    window.moveTo(Math.max(0, (screen.width - 560) / 2), Math.max(0, (screen.height - 680) / 2));
  } catch (e) {}
  document.getElementById('pick').focus();
}

// 重启 NapCat（force=true 时先杀现有进程），强制它画新码
function restartNapcat(force) {
  var sh = new ActiveXObject('WScript.Shell');
  if (force) {
    try {
      var wmi = GetObject('winmgmts:\\\\.\\root\\cimv2');
      var items = wmi.ExecQuery("SELECT ProcessId, CommandLine FROM Win32_Process WHERE Name='node.exe'");
      var e = new Enumerator(items);
      for (; !e.atEnd(); e.moveNext()) {
        var cl = String(e.item().CommandLine || '');
        if (cl.indexOf('NapCat.Shell.v4') >= 0) {
          sh.Run('taskkill /F /T /PID ' + e.item().ProcessId, 0, true);
        }
      }
    } catch (err) {}
  }
  sh.Run('cmd /c "' + NAPBAT + '" -q ' + QQUIN, 0, false);
  qrBaseMs = mtimeMs(QR_IMG);   // 重启后只认新画的码
  qrStart = (new Date()).getTime();
}

// 放大最新码 → 输出唯一文件名（纯 ASCII 路径，避开 IE 对中文 file URL 和缓存的问题）→ 展示
function genQr() {
  var sh = new ActiveXObject('WScript.Shell');
  var ts = (new Date()).getTime();
  var outp = QR_OUT_DIR + '\\qr-' + ts + '.png';
  // 确保输出目录存在（首次运行）
  try {
    var fso = new ActiveXObject('Scripting.FileSystemObject');
    if (!fso.FolderExists(QR_OUT_DIR)) fso.CreateFolder(QR_OUT_DIR);
  } catch (err0) {}
  // 清掉其他临时图（保留当前正在显示的那张）
  try {
    var fso = new ActiveXObject('Scripting.FileSystemObject');
    var curName = '';
    try { curName = decodeURIComponent(String(document.getElementById('qrimg').src || '')).split('/').pop(); } catch (e0) {}
    var folder = fso.GetFolder(QR_OUT_DIR);
    var e = new Enumerator(folder.Files);
    for (; !e.atEnd(); e.moveNext()) {
      if (/^qr-\d+\.png$/i.test(e.item().Name) && e.item().Name !== curName) e.item().Delete(true);
    }
  } catch (err) {}
  sh.Run('"' + PY + '" "' + QR_TOOL + '" "' + QR_IMG + '" "' + outp + '"', 0, true);   // 同步，约 1 秒
  var img = document.getElementById('qrimg');
  img.src = 'file:///' + outp.replace(/\\/g, '/');
  img.style.display = 'block';
  qrBaseMs = mtimeMs(QR_IMG);
  qrShown = true;
  stat('请用手机 QQ 扫描上方二维码', 'warn');
}

function qrTick() {
  // 1) 登录成功 = OneBot 3000 端口有响应
  if (httpGet('http://127.0.0.1:3000/get_status') !== 0) {
    window.clearInterval(qrTimer); qrTimer = null;
    stat('QQ 登录成功，机器人已恢复', 'ok');
    window.setTimeout(closeQr, 4000);
    return;
  }
  // 2) NapCat 画出了比基准新的码 → 展示
  var m = mtimeMs(QR_IMG);
  if (m > 0 && m > qrBaseMs) { genQr(); return; }
  // 3) 迟迟没新码：NapCat 画过一次等扫、过期后不自动重画，得重启它强制换码（最多自动重启 3 次）
  var idle = ((new Date()).getTime() - Math.max(qrStart, qrBaseMs)) / 1000;
  if (idle > 90 && qrRestarts < 3) {
    qrRestarts++;
    stat('超过 90 秒没有新码，自动重启 NapCat（第 ' + qrRestarts + ' 次）…', 'warn');
    restartNapcat(true);
    return;
  }
  if (qrRestarts >= 3) {
    stat('自动重启 3 次仍未出码，去看 NapCat 控制台窗口的报错，或跟我说一声', 'warn');
  }
}
</script>
</body>
</html>
