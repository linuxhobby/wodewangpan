# 依赖
node_modules/

# 构建产物（服务器 clone 后自行 npm run build 生成，不入库）
public/
public.new/
public.old/
.next/
out/
dist/

# 搜索引擎站点验证文件：确认无误后下载到本地根目录，由 nginx 托管 + 不入库
# （VPS 上放 /opt/seo/，nginx 映射成 /baidu_verify_*.html，避免被 atomic 发布清掉）
baidu_verify_*.html

# IndexNow 密钥：协议要求可公开访问，但值不入库（VPS 上放 /opt/indexnow/key.txt，由 nginx 映射成 /key.txt）
static/key.txt

# 本地环境
.env
*.log
.DS_Store
Thumbs.db

# 本地缓存
.tmp/
.cache/
# npm run serve 的临时输出
.tmp-serve.err
.tmp-serve.out

# 夸克 CLI 的落盘产物：browse 任务 JSONL 与写权限探针，会落在执行时的 cwd 下
browse/
.quarkclouddrive/

# 本地 skill 与凭据（含 cookie / token，严禁入库；现网真身在 ~/.workbuddy/skills/ 下使用）
skills/
# skill 安装锁文件，只反映本机的安装状态
skills-lock.json
config.env

# （2026-11-12 机器人已迁至私有仓 mybot，原 bot/**/qr-*.png 两条临时图规则随之移除）
# 私有仓：凭据按指挥官口径原样入库（config.json / *.env 不再排除）
# 但运行态与可再生垃圾永远不进 git——聊天日志里有用户 id 与会话内容，属隐私不是配置
logs/
__pycache__/
*.pyc
*.pyo
*.lnk

# 扫码面板/桌面落盘的一次性二维码临时图
bot/icons/qr-*.png
bot/**/qr-*.png

# Telegram / Bluesky 判重记录：现网状态，只留本机（删了会重复发）
posted.json
*.state.json

# WorkBuddy 自动化在本目录留下的本地运行态（memory/automations 等），不进 git
.workbuddy/

# ===== 2026-11-17 mybot 并入后新增 =====
# 本仓库公开，凭据一律不进 git（历史已用 filter-repo 清洗），真身只留运行机本地
bot/config.json
push/**/*.env
