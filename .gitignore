# 依赖
node_modules/

# 构建产物（服务器 clone 后自行 npm run build 生成，不入库）
public/
public.new/
public.old/
.next/
out/
dist/

# 搜索引擎站点验证文件：确认无误后下载到本地根目录，由 nginx 托管 + 不入库
# （VPS 上放 /opt/seo/，nginx 映射成 /baidu_verify_*.html，避免被 atomic 发布清掉）
baidu_verify_*.html

# IndexNow 密钥：协议要求可公开访问，但值不入库（VPS 上放 /opt/indexnow/key.txt，由 nginx 映射成 /key.txt）
static/key.txt

# 本地环境
.env
*.log
.DS_Store
Thumbs.db

# 本地缓存
.tmp/
.cache/
# npm run serve 的临时输出
.tmp-serve.err
.tmp-serve.out

# 本地 skill 与凭据（含 cookie / token，严禁入库；实际放在 ~/.workbuddy/skills/ 下使用）
skills/
# skill 安装锁文件，只反映本机的安装状态
skills-lock.json
config.env
